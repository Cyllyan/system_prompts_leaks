# Copia este archivo a ".env" y rellena los valores.

# Secreto que el iPhone enviará en la cabecera x-agent-token.
# Pon algo largo y aleatorio (p. ej. genera uno con: openssl rand -hex 24)
AGENTE_TOKEN=cambia-esto-por-un-secreto-largo

# (Opcional) Ruta del repo si no arrancas desde mi-agente/servidor/
# AGENTE_PROJECT_DIR=/ruta/a/system_prompts_leaks

# (Opcional) Ruta del binario de Claude Code si "claude" no está en el PATH
# CLAUDE_BIN=/usr/local/bin/claude
